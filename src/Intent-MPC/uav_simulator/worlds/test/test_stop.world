
            <sdf version='1.7'>
            <world name='default'>
                <light name='sun' type='directional'>
                <cast_shadows>1</cast_shadows>
                <pose>0 0 10 0 -0 0</pose>
                <diffuse>0.8 0.8 0.8 1</diffuse>
                <specular>0.2 0.2 0.2 1</specular>
                <attenuation>
                    <range>1000</range>
                    <constant>0.9</constant>
                    <linear>0.01</linear>
                    <quadratic>0.001</quadratic>
                </attenuation>
                <direction>-0.5 0.1 -0.9</direction>
                <spot>
                    <inner_angle>0</inner_angle>
                    <outer_angle>0</outer_angle>
                    <falloff>0</falloff>
                </spot>
                </light>
                


                <!-- Ground Plane地面 -->
                <model name='ground_plane'>
                  <static>true</static>
                  <link name='link'>
                    <collision name='collision'>
                      <geometry>
                        <plane>
                          <normal>0 0 1</normal>
                          <size>100 100</size>
                        </plane>
                      </geometry>
                      <surface>
                        <friction>
                          <ode>
                            <mu>100</mu>
                            <mu2>50</mu2>
                          </ode>
                        </friction>
                      </surface>
                    </collision>
                    <visual name='visual'>
                      <cast_shadows>0</cast_shadows>
                      <geometry>
                        <plane>
                          <normal>0 0 1</normal>
                          <size>100 100</size>
                        </plane>
                      </geometry>
                      <material>
                        <script>
                          <uri>file://media/materials/scripts/gazebo.material</uri>
                          <name>Gazebo/Grey</name>
                        </script>
                      </material>
                    </visual>
                  </link>
                </model>
                 
                            
                             
                            
                             
                            
                             
                         
                            
                            <!-- 动态障碍物：急停场景 -->
                            <model name='dynamic_cylinder_0.6_0.6_1.7'>
                            <static>true</static>
                            <pose>-3 2 0.65 0 0 0</pose> <!-- X, Y, Z, Roll, Pitch, Yaw -->
                            <link name='link'>
                                <visual name='visual'>
                                    <geometry>
                                        <cylinder>
                                            <radius>0.3</radius>
                                            <length>1.7</length>
                                        </cylinder>
                                    </geometry>
                                    <material>
                                        <ambient>0.1 0.6 0.9 1</ambient> <!-- Blue color -->
                                        <diffuse>0.1 0.6 0.9 1</diffuse> <!-- Blue color -->
                                        <specular>0.5 0.5 0.5 1</specular> <!-- Specular highlight -->
                                    </material>
                                </visual>
                            </link>
                            <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
                                <orientation>false</orientation>
                                <loop>0</loop>
                                <velocity>1.5</velocity>
                                <path>
                                <!-- 场景设计：从(-3, 2)出发 → 到(-2, -2)急停5秒 → 原路返回(-3, 2) → 再停5秒 -->
                                
                                <!-- 起点：左上方 (-3, 2) -->
                                <waypoint>-3 2 0</waypoint>
                                
                                <!-- 第一段：移动到(-2, -2)，距离约4.1米，耗时约10秒 -->
                                <waypoint>-2 -2 0</waypoint>
                                
                                <!-- 第二段：急停5秒 - 使用原地转小圈（半径0.15米的圆，速度0.4m/s，周长约0.94米，转5圈约需4.7秒≈5秒）-->
                                <waypoint>-1.85 -2 0</waypoint>      <!-- 右 -->
                                <waypoint>-2 -1.85 0</waypoint>      <!-- 上 -->
                                <waypoint>-2.15 -2 0</waypoint>      <!-- 左 -->
                                <waypoint>-2 -2.15 0</waypoint>      <!-- 下 -->
                                <waypoint>-1.85 -2 0</waypoint>      <!-- 右，完成1圈 -->
                                
                                <waypoint>-2 -1.85 0</waypoint>      <!-- 第2圈 -->
                                <waypoint>-2.15 -2 0</waypoint>
                                <waypoint>-2 -2.15 0</waypoint>
                                <waypoint>-1.85 -2 0</waypoint>
                                
                                <waypoint>-2 -1.85 0</waypoint>      <!-- 第3圈 -->
                                <waypoint>-2.15 -2 0</waypoint>
                                <waypoint>-2 -2.15 0</waypoint>
                                <waypoint>-1.85 -2 0</waypoint>
                                
                                <waypoint>-2 -1.85 0</waypoint>      <!-- 第4圈 -->
                                <waypoint>-2.15 -2 0</waypoint>
                                <waypoint>-2 -2.15 0</waypoint>
                                <waypoint>-1.85 -2 0</waypoint>
                                
                                <waypoint>-2 -1.85 0</waypoint>      <!-- 第5圈 -->
                                <waypoint>-2.15 -2 0</waypoint>
                                <waypoint>-2 -2.15 0</waypoint>
                                <waypoint>-2 -2 0</waypoint>         <!-- 回到中心点 -->
                                
                                <!-- 第三段：原路返回起点(-3, 2)，距离约4.1米，耗时约10秒 -->
                                <waypoint>-3 2 0</waypoint>
                                
                                <!-- 第四段：在起点停5秒 - 再转5圈小圈 -->
                                <waypoint>-2.85 2 0</waypoint>       <!-- 右 -->
                                <waypoint>-3 2.15 0</waypoint>       <!-- 上 -->
                                <waypoint>-3.15 2 0</waypoint>       <!-- 左 -->
                                <waypoint>-3 1.85 0</waypoint>       <!-- 下 -->
                                <waypoint>-2.85 2 0</waypoint>       <!-- 第1圈完成 -->
                                
                                <waypoint>-3 2.15 0</waypoint>       <!-- 第2圈 -->
                                <waypoint>-3.15 2 0</waypoint>
                                <waypoint>-3 1.85 0</waypoint>
                                <waypoint>-2.85 2 0</waypoint>
                                
                                <waypoint>-3 2.15 0</waypoint>       <!-- 第3圈 -->
                                <waypoint>-3.15 2 0</waypoint>
                                <waypoint>-3 1.85 0</waypoint>
                                <waypoint>-2.85 2 0</waypoint>
                                
                                <waypoint>-3 2.15 0</waypoint>       <!-- 第4圈 -->
                                <waypoint>-3.15 2 0</waypoint>
                                <waypoint>-3 1.85 0</waypoint>
                                <waypoint>-2.85 2 0</waypoint>
                                
                                <waypoint>-3 2.15 0</waypoint>       <!-- 第5圈 -->
                                <waypoint>-3.15 2 0</waypoint>
                                <waypoint>-3 1.85 0</waypoint>
                                <waypoint>-3 2 0</waypoint>          <!-- 回到起点 -->
                                </path>
                            </plugin>
                            </model> 
                            
                             
                            
                             
                    
                             
                    
                             
                               
                             
                            
            </world>
            </sdf>
            

