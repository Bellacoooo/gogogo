    <!-- 动态7: 斜向往返 (4,-8) <-> (-4,-6) -->
    <model name='dynamic_cylinder_7_0.6_0.6_1.7'>
      <static>true</static>
      <pose>4.0 -8.0 0.85 0 0 0</pose>
