        <velocity>0.4</velocity>
        <path>
          <waypoint>4.0 -8.0 0.85</waypoint>
          <waypoint>-4.0 -6.0 0.85</waypoint>
        </path>
      </plugin>
    </model>

    <!-- ===================== 静态方形障碍物 ====================== -->

    <!-- 静态方形0: (-3, -7) -->
    <model name='static_box_0'>
      <static>true</static>
      <pose>-3.0 -7.0 1.0 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>1.0 1.0 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name='collision'>
