<sdf version='1.7'>
  <world name='default'>

    <!-- ============================================================ -->
    <!-- 场景说明: 10x20 地图 (X: [-5,5], Y: [-10,10])               -->
    <!-- 6 个静态方形障碍物 (灰色) + 8 个动态圆柱障碍物 (红色)       -->
    <!-- 环境/颜色参考 test_A_star.world                              -->
    <!-- ============================================================ -->

    <!-- ===================== 动态圆柱障碍物 ====================== -->

    <!-- 动态0: 沿 X 往返 (-4,-9) <-> (4,-9) -->
    <model name='dynamic_cylinder_0_0.6_0.6_1.7'>
      <static>true</static>
      <pose>-4.0 -9.0 0.85 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <orientation>false</orientation>
        <loop>1</loop>
        <velocity>0.4</velocity>
        <path>
          <waypoint>-4.0 -9.0 0.85</waypoint>
          <waypoint>4.0 -9.0 0.85</waypoint>
        </path>
      </plugin>
    </model>

    <!-- 动态1: 沿 Y 往返 (-1,-5) <-> (-1,1) -->
    <model name='dynamic_cylinder_1_0.6_0.6_1.7'>
      <static>true</static>
      <pose>-1.0 -5.0 0.85 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <orientation>false</orientation>
        <loop>1</loop>
        <velocity>0.45</velocity>
        <path>
          <waypoint>-1.0 -5.0 0.85</waypoint>
          <waypoint>-1.0 1.0 0.85</waypoint>
        </path>
      </plugin>
    </model>

    <!-- 动态2: 沿 Y 往返 (4,-4) <-> (4,2) -->
    <model name='dynamic_cylinder_2_0.6_0.6_1.7'>
      <static>true</static>
      <pose>4.0 -4.0 0.85 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.7</length>
            </cylinder>
