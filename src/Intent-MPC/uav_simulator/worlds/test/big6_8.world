          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <orientation>false</orientation>
        <loop>1</loop>
        <velocity>0.38</velocity>
        <path>
          <waypoint>4.0 -4.0 0.85</waypoint>
          <waypoint>4.0 2.0 0.85</waypoint>
        </path>
      </plugin>
    </model>

    <!-- 动态3: 斜向往返 (-1,-6) <-> (3,-2) -->
    <model name='dynamic_cylinder_3_0.6_0.6_1.7'>
      <static>true</static>
      <pose>-1.0 -6.0 0.85 0 0 0</pose>
