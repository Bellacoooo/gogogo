<sdf version='1.7'>
  <world name='default'>
    <!-- 动态障碍物：参考 generated_env.world 的格式 -->
    <!-- 障碍物1：从 (-2.38, 4.25) 到 (-2.38, -5.49) -->
    <model name='dynamic_cylinder_0_0.6_0.6_1.7'>
      <static>true</static>
      <pose>-2.38 4.25 0.85 0 0 0</pose> <!-- X, Y, Z, Roll, Pitch, Yaw -->
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient> <!-- Red color -->
            <diffuse>1 0 0 1</diffuse> <!-- Red color -->
            <specular>0.5 0.5 0.5 1</specular> <!-- Specular highlight -->
          </material>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <orientation>false</orientation>
        <loop>1</loop>
        <velocity>0.4</velocity>
        <path>
          <waypoint>-2.38 3.25 0.85</waypoint>
          <waypoint>-2.38 -2.49 0.85</waypoint>
          <waypoint>-2.38 3.25 0.85</waypoint>
          <waypoint>-2.38 -2.49 0.85</waypoint>
        </path>
      </plugin>
    </model> 
    
    <!-- 障碍物2：从 (-4.82, -5.29) 到 (-4.82, 5.29) -->
    <model name='dynamic_cylinder_1_0.6_0.6_1.7'>
      <static>true</static>
      <pose>-4.82 -5.29 0.85 0 0 0</pose> <!-- X, Y, Z, Roll, Pitch, Yaw -->
      <link name='link'>
        <visual name='visual'>
          <geometry>
