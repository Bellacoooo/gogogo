<sdf version='1.7'>
  <world name='default'>

    <!-- ============================================================ -->
    <!-- 场景说明: 10x10 地图 (X: [-5,5], Y: [-5,5])                -->
    <!-- 仅动态障碍物: 4 个动态圆柱                                  -->
    <!-- 障碍物尺寸按原始参考大小 1.5 倍                             -->
    <!-- ============================================================ -->

    <!-- 1.5 倍尺寸: radius=0.45, length=2.55, z=1.275 -->

    <!-- 动态0: 沿 X 往返 (-3.2,-2.8) <-> (1.8,-2.8) -->
    <model name='dynamic_cylinder_0_0.9_0.9_2.55'>
      <static>true</static>
      <pose>-3.2 -2.8 1.275 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>2.55</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <orientation>false</orientation>
        <loop>1</loop>
        <velocity>0.0</velocity>
        <path>
          <waypoint>-3.2 -2.8 1.275</waypoint>
          <waypoint>-3.2 -2.8 1.275</waypoint>
        </path>
      </plugin>
    </model>

    <!-- 动态1: 沿 Y 往返 (-0.8,-2.2) <-> (-0.8,2.2) -->
    <model name='dynamic_cylinder_1_0.9_0.9_2.55'>
      <static>true</static>
      <pose>-0.8 -2.2 1.275 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>2.55</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <orientation>false</orientation>
        <loop>1</loop>
        <velocity>0.0</velocity>
        <path>
          <waypoint>-0.8 -2.2 1.275</waypoint>
          <waypoint>-0.8 -2.2 1.275</waypoint>
        </path>
      </plugin>
    </model>

    <!-- 动态2: 斜向往返 (2.4,-0.6) <-> (-1.2,2.0) -->
    <model name='dynamic_cylinder_2_0.9_0.9_2.55'>
      <static>true</static>
      <pose>2.4 -0.6 1.275 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>2.55</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <orientation>false</orientation>
        <loop>1</loop>
        <velocity>0.0</velocity>
        <path>
          <waypoint>2.4 -0.6 1.275</waypoint>
          <waypoint>2.4 -0.6 1.275</waypoint>
        </path>
      </plugin>
    </model>

    <!-- 动态3: 沿 X 往返 (-1.8,2.8) <-> (2.4,2.8) -->
    <model name='dynamic_cylinder_3_0.9_0.9_2.55'>
      <static>true</static>
      <pose>-1.8 2.8 1.275 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>2.55</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <orientation>false</orientation>
        <loop>1</loop>
        <velocity>0.0</velocity>
        <path>
          <waypoint>-1.8 2.8 1.275</waypoint>
          <waypoint>-1.8 2.8 1.275</waypoint>
        </path>
      </plugin>
    </model>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>6.39292 -16.0551 24.6198 0 0.913797 2.1162</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
